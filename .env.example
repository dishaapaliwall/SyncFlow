
# Source PostgreSQL database
SYNCFLOW_SOURCE_URL=jdbc:postgresql://localhost:5434/syncflow_source
SYNCFLOW_SOURCE_USERNAME=syncflow
SYNCFLOW_SOURCE_PASSWORD=replace_me

# Target PostgreSQL database
SYNCFLOW_TARGET_URL=jdbc:postgresql://localhost:5435/syncflow_target
SYNCFLOW_TARGET_USERNAME=syncflow
SYNCFLOW_TARGET_PASSWORD=replace_me

# CDC configuration
SYNCFLOW_CDC_SLOT=syncflow_slot
SYNCFLOW_CDC_PUBLICATION=syncflow_publication

JAVA_TOOL_OPTIONS="-Duser.timezone=UTC"
